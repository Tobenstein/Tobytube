{
  "name": "tobytube",
  "version": "1.0.0",
  "description": "A personal media-server prototype focused on movies, TV, and wrestling timeline browsing.",
  "type": "commonjs",
  "scripts": {
    "twdb:repair:nwa-78": "node scripts/repair-nwa-78th-anniversary-2026.mjs",
    "twdb:apply:wwe-hof-2026": "node scripts/apply-wwe-hall-of-fame-2026.mjs",
    "twdb:validate": "node scripts/validate-twdb-refresh.mjs",
    "twdb:refresh": "node scripts/refresh-twdb.mjs",
    "start": "node scripts/tobytube-server.mjs",
    "dev": "node scripts/tobytube-server.mjs",
    "service": "node scripts/start-service.mjs",
    "scan": "node scripts/metadata-pipeline.mjs",
    "scan:refresh": "node scripts/metadata-pipeline.mjs --refresh-providers",
    "posters": "node scripts/fetch-tmdb-posters.mjs",
    "collections:manifest": "node scripts/build-curated-manifest.mjs",
    "wrestling:split-reference": "node scripts/split-wrestling-reference.mjs",
    "movies:details": "node scripts/fetch-movie-details.mjs",
    "tv:details": "node scripts/fetch-tv-details.mjs",
    "collections:mcu": "node scripts/fetch-mcu-collection.mjs",
    "collections:criterion": "node scripts/build-criterion-collection.mjs",
    "collections:disney-shorts": "node scripts/build-disney-shorts.mjs",
    "collections:looney-golden": "node scripts/build-looney-tunes-golden-collection.mjs",
    "collections:looney-tunes-golden": "node scripts/build-looney-tunes-golden-collection.mjs",
    "collections:looney-tunes-match": "node scripts/match-looney-tunes-shorts.mjs",
    "collections:disney-shorts:match": "node scripts/match-disney-shorts.mjs",
    "wrestling:nwa-history": "powershell -ExecutionPolicy Bypass -File scripts/import-nwa-history-covers.ps1",
    "wrestling:nwa-history:normalize": "node scripts/normalize-nwa-history.mjs",
    "wrestling:aew-redemption-2026-results": "node scripts/apply-aew-redemption-2026-results.mjs",
    "check:json": "node -e \"JSON.parse(require('fs').readFileSync('src/tmdb-posters.generated.json','utf8')); JSON.parse(require('fs').readFileSync('config/tobytube.config.json','utf8')); console.log('json ok')\"",
    "test:api-v1": "node scripts/test-api-v1-contract.mjs",
    "test:api-v1-policy": "node scripts/test-api-v1-access-policy.mjs",
    "test:api-v1-auth": "node scripts/test-api-v1-auth.mjs",
    "test:api-v1-user-data": "node scripts/test-api-v1-user-data.mjs",
    "test:api-v1-playback": "node scripts/test-api-v1-playback.mjs",
    "test:api-v1-catalogue": "node scripts/test-api-v1-catalogue.mjs",
    "test:player-time": "node scripts/test-player-time.mjs",
    "test:shorts-playback": "node scripts/test-shorts-playback.mjs",
    "test:animation-randomizer": "node scripts/test-animation-randomizer.mjs",
    "test:wrestling-scan": "node scripts/test-wrestling-scan-logic.mjs",
    "test": "npm run check:json && npm run test:player-time && npm run test:shorts-playback && npm run test:animation-randomizer && npm run test:api-v1 && npm run test:api-v1-policy && npm run test:api-v1-auth && npm run test:api-v1-user-data && npm run test:api-v1-playback && npm run test:api-v1-catalogue"
  },
  "keywords": [
    "media",
    "prototype",
    "tobytube"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
}
