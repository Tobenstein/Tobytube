ics as a nostalgic trip down hardcore memory lane, settling long-standing feuds in front of one of the most rabid crowds in wrestling history! See how this event set Philly on fire with a NOVEMBER REIGN TO REMEMBER! PLUS: Justin Credible vs. Jerry Lynn in a Steel Cage Match; Shane Douglas vs. Pit-bull Gary Wolfe in a Dog Collar Chain Match, and much, much more."}],"matches":[{"id":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10-wwfoldschool-match-1","eventId":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10","eventRecordType":"event","promotionId":"ecw","order":1,"label":"1","raw":"Sabu vs. Terry Funk vs. Shane Douglas","displayText":"Sabu vs. Terry Funk vs. Shane Douglas","stipulation":null,"titleMatch":null,"championshipId":null,"participants":[{"name":"Sabu"},{"name":". Terry Funk"}],"teams":[],"champions":[],"championMarked":false,"spoilerSafe":true,"sourceIds":["wwfoldschool-archive"],"externalIds":{"wwfoldschool":{"url":"http://wwfoldschool.com/?page_id=6242"}},"winner":null,"result":null},{"id":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10-wwfoldschool-match-2","eventId":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10","eventRecordType":"event","promotionId":"ecw","order":2,"label":"2","raw":"Raven vs. Sandman","displayText":"Raven vs. Sandman","stipulation":null,"titleMatch":null,"championshipId":null,"participants":[{"name":"Raven"},{"name":". Sandman"}],"teams":[],"champions":[],"championMarked":false,"spoilerSafe":true,"sourceIds":["wwfoldschool-archive"],"externalIds":{"wwfoldschool":{"url":"http://wwfoldschool.com/?page_id=6242"}},"winner":null,"result":null},{"id":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10-wwfoldschool-match-3","eventId":"wwfoldschool-ecw-ecw-ppvs-and-events-2005-06-10","eventRecordType":"event","promotionId":"ecw","order":3,"label":"3","raw":"Justin Credible vs. Jerry Lynn","displayText":"Justin Credible vs. Jerry Lynn","stipulation":null,"titleMatch":null,"championshipId":null,"participants":[{"name":"Justin Credible"},{"n