{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tobytube: Launch Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/scripts/tobytube-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8092"
      },
      "serverReadyAction": {
        "pattern": "Tobytube preview running at (http://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Tobytube: Launch Background Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/scripts/start-service.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8092"
      },
      "serverReadyAction": {
        "pattern": "Tobytube started at (http://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
